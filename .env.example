# .env.example: Blank settings template for other people
#
# Safe blank copy of YourCont settings for markers or another computer.
# Same names as .env, but empty values.
# Clone the repo, copy this file to .env, then fill in your own secrets.
# This file goes on GitHub; the real .env does not.

# Copy this file to .env and fill in your own values.

# Flask signs session cookies with this value so logged in state stays trustworthy.
SECRET_KEY=

# Local Postgres connection for YourCont during development.
# Example: postgresql://postgres:YOUR_PASSWORD@localhost:5432/yourcont
DATABASE_URL=

# S3 bucket name for contact profile images.
S3_BUCKET=

# Sydney region, closest AWS region to New Zealand for lower latency.
AWS_REGION=ap-southeast-2

# Set to 1 only on Elastic Beanstalk so session cookies require HTTPS.
SESSION_COOKIE_SECURE=0
